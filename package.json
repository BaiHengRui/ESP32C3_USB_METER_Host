{
  "name": "esp32_usb_meter_host",
  "version": "2.1.0",
  "description": "ESP32 USB METER Host Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild:win": "node -e \"const fs=require('fs');fs.writeFileSync('build-info.json',JSON.stringify({buildTime:new Date().toISOString()}))\"",
    "build:win": "npm run prebuild:win && electron-builder --win && npm run zip:dir",
    "zip:dir": "node -e \"const{execSync}=require('child_process');const p=require('./package.json');const d=p.build.directories.output;execSync('powershell -Command Compress-Archive -Path '+d+'/win-unpacked/* -DestinationPath '+d+'/'+p.build.productName+'-v'+p.version+'-win-x64.zip -CompressionLevel Optimal -Force',{stdio:'inherit'})\"",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.esp32usb.meter",
    "productName": "ESP32-USB-METER",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "executableName": "ESP32USB_Meter_Host",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-v${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/esptool-js/**",
      "node_modules/@serialport/**",
      "node_modules/serialport/**"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "firmware-flash.js",
      "firmware-renderer.js",
      "serialport-transport.js",
      "index.html",
      "curve.html",
      "firmware.html",
      "driver.html",
      "styles.css",
      "build-info.json",
      "version-info.json",
      "node_modules/html2canvas/dist/html2canvas.min.js",
      "node_modules/chart.js/dist/chart.umd.js",
      "node_modules/chartjs-plugin-zoom/dist/chartjs-plugin-zoom.min.js",
      "node_modules/@serialport/**",
      "node_modules/serialport/**",
      "node_modules/esptool-js/**",
      "node_modules/debug/src/**"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": ["**/*"]
      },
      {
        "from": "drives",
        "to": "drives",
        "filter": ["**/*"]
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    }
  },
  "keywords": [
    "electron",
    "esp32",
    "usb",
    "meter"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "esptool-js": "^0.6.0",
    "html2canvas": "^1.4.1",
    "serialport": "^12.0.0"
  }
}
